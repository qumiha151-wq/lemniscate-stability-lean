theorem start5_checked : ∀i : Fin 6,table5.coefficient 0 i=⟨Block16Nodes.matrix 8 5 i,0⟩ := by decide +kernel

theorem endpoint5_checked : evaluateFixedTaylor mesh step table5 22=endpoint5 := by decide +kernel

theorem endpoint5_enclosed (i : Fin 6) : (endpoint5[i.val]).Contains mesh
    ((variationPolynomial (Block16Nodes.state 8) (Block16Nodes.operator 8 (coordinateBasis 5)) 22 i).eval (step:ℝ)) := by
  rw [←endpoint5_checked]
  apply certifiedMixedVariation_endpoint_contains mesh_pos Block16Leaf08State.state_sound (by omega) column5_checked
  intro i
  rw [start5_checked]
  exact Block16Nodes.start_column_contains 8 5 i

def fullEndpoint : Fin 6 → Vector FixedBall 6 := ![endpoint0,endpoint1,endpoint2,endpoint3,endpoint4,endpoint5]

theorem endpoint_enclosed (col i : Fin 6) : (fullEndpoint col)[i.val].Contains mesh
    ((variationPolynomial (Block16Nodes.state 8) (Block16Nodes.operator 8 (coordinateBasis col)) 22 i).eval (step:ℝ)) := by
  fin_cases col
  · exact endpoint0_enclosed i
  · exact endpoint1_enclosed i
  · exact endpoint2_enclosed i
  · exact endpoint3_enclosed i
  · exact endpoint4_enclosed i
  · exact endpoint5_enclosed i

theorem endpoint_center_checked : ∀col i : Fin 6,(fullEndpoint col)[i.val].center=Block16Nodes.matrix 9 col i := by decide +kernel

theorem radius_rows_checked : ∀i : Fin 6,∑col : Fin 6,((fullEndpoint col)[i.val].radius:ℚ)/mesh≤1/10^55 := by decide +kernel

theorem matrix_reset : ‖referencePolynomialMatrix 1 (Block16Nodes.state 8) 22 (Block16Nodes.operator 8) (step:ℝ)-Block16Nodes.operator 9‖≤1/10^55 := by
  have he (col i : Fin 6) : ((fullEndpoint col)[i.val]).Contains mesh
      ((variationPolynomialMap (Block16Nodes.state 8) 22 (step:ℝ)).comp (Block16Nodes.operator 8) (coordinateBasis col) i) := by
    simp only [ContinuousLinearMap.comp_apply,variationPolynomialMap_apply]
    exact endpoint_enclosed col i
  have hc : fixedMatrixMidpoint mesh (fun col i=>(fullEndpoint col)[i.val])=Block16Nodes.operator 9 := by
    simp only [fixedMatrixMidpoint,Block16Nodes.operator,pointMatrixOperator,endpoint_center_checked]
  have h:=fixedMatrixMidpoint_error he (by norm_num) radius_rows_checked
  rw [hc] at h
  simp only [referencePolynomialMatrix,one_mul]
  convert! h using 1
  norm_num

end SolitonClassification.Rotating.Block16Leaf08Matrix

#print axioms SolitonClassification.Rotating.Block16Leaf08Matrix.matrix_reset

open Lean Elab Command in
run_cmd do
  for (name, _) in (← getEnv).constants do
    if (`SolitonClassification.Rotating).isPrefixOf name then
      for a in (← collectAxioms name) do
        unless #[`propext,`Classical.choice,`Quot.sound].contains a do
          throwError "Axiom audit failed: {name} depends on {a}"
  logInfo "Block16 concrete leaf audit passed; standard axioms only."
