def centers : ℕ → Fin 6 → ℤ
  | 0 => centers0
  | 1 => centers1
  | 2 => centers2
  | 3 => centers3
  | 4 => centers4
  | 5 => centers5
  | 6 => centers6
  | 7 => centers7
  | 8 => centers8
  | _ => centers8

def matrix : ℕ → PointMatrix
  | 0 => B0
  | 1 => B1
  | 2 => B2
  | 3 => B3
  | 4 => B4
  | 5 => B5
  | 6 => B6
  | 7 => B7
  | 8 => B8
  | _ => B8

def inverseProposal : ℕ → PointMatrix
  | 0 => C0
  | 1 => C1
  | 2 => C2
  | 3 => C3
  | 4 => C4
  | 5 => C5
  | 6 => C6
  | 7 => C7
  | 8 => C8
  | _ => C8

def rawState (j : ℕ) (i : Fin 6) : ℚ := if j=0 then rawInitial i else (centers j i:ℚ)/mesh

def state (j : ℕ) : State := fun i=>(rawState j i:ℝ)

def operator (j : ℕ) : FlowEnd := pointMatrixOperator mesh (matrix j)

def startBalls (j : ℕ) (i : Fin 6) : FixedBall := if j=0 then initialBalls i else ⟨centers j i,0⟩

theorem state_zero : state 0=initial := rfl

theorem state_one : state 1=Grid42P00Nodes.nextState := rfl

theorem operator_zero : operator 0=Grid42P00Nodes.startOperator := rfl

theorem operator_one : operator 1=Grid42P00Nodes.nextOperator := rfl

theorem operator_initial : operator 0=1 := Grid42P00Nodes.start_identity

theorem start_contains (j : ℕ) (i : Fin 6) : (startBalls j i).Contains mesh (state j i) := by
  by_cases hj : j=0
  · subst j
    exact initial_enclosed i
  · simp [startBalls,state,rawState,hj,FixedBall.Contains,FixedBall.toRational,RationalBall.Contains]

theorem start_column_contains (j : ℕ) (c i : Fin 6) :
    (⟨matrix j c i,0⟩:FixedBall).Contains mesh (operator j (coordinateBasis c) i) := by
  change (⟨matrix j c i,0⟩:FixedBall).Contains mesh (pointMatrixOperator mesh (matrix j) (coordinateBasis c) i)
  rw [pointMatrixOperator_basis]
  simp [FixedBall.Contains,FixedBall.toRational,RationalBall.Contains]

theorem valid0 : PointNodeValid (matrix 0) (inverseProposal 0) := Grid42P00Nodes.start_valid

run_cmd Lean.logInfo "Block8 point matrix 0 checked."

theorem valid1 : PointNodeValid (matrix 1) (inverseProposal 1) := Grid42P00Nodes.next_valid

run_cmd Lean.logInfo "Block8 point matrix 1 checked."

theorem valid2 : PointNodeValid (matrix 2) (inverseProposal 2) := by decide +kernel

run_cmd Lean.logInfo "Block8 point matrix 2 checked."

theorem valid3 : PointNodeValid (matrix 3) (inverseProposal 3) := by decide +kernel

run_cmd Lean.logInfo "Block8 point matrix 3 checked."

theorem valid4 : PointNodeValid (matrix 4) (inverseProposal 4) := by decide +kernel

run_cmd Lean.logInfo "Block8 point matrix 4 checked."

theorem valid5 : PointNodeValid (matrix 5) (inverseProposal 5) := by decide +kernel

run_cmd Lean.logInfo "Block8 point matrix 5 checked."

theorem valid6 : PointNodeValid (matrix 6) (inverseProposal 6) := by decide +kernel

run_cmd Lean.logInfo "Block8 point matrix 6 checked."

theorem valid7 : PointNodeValid (matrix 7) (inverseProposal 7) := by decide +kernel

run_cmd Lean.logInfo "Block8 point matrix 7 checked."

theorem valid8 : PointNodeValid (matrix 8) (inverseProposal 8) := by decide +kernel

run_cmd Lean.logInfo "Block8 point matrix 8 checked."

theorem valid (j : ℕ) (hj : j≤8) : PointNodeValid (matrix j) (inverseProposal j) := by
  interval_cases j
  · exact valid0
  · exact valid1
  · exact valid2
  · exact valid3
  · exact valid4
  · exact valid5
  · exact valid6
  · exact valid7
  · exact valid8

theorem bounds (j : ℕ) (hj : j≤8) : ‖operator j‖≤2000 ∧ IsUnit (operator j) ∧
    ‖Ring.inverse (operator j)‖≤4000 := (valid j hj).sound

theorem raw_inner (j : ℕ) (hj : j≤8) : |rawState j 0|≤407/50 ∧ |rawState j 1|≤33/8 ∧
    |rawState j 2|≤731/100 ∧ |rawState j 3|≤731/100 ∧ |rawState j 4|≤1/100 := by
  interval_cases j <;> decide +kernel

theorem inner (j : ℕ) (hj : j≤8) : state j∈innerTube := by
  have lift (q r : ℚ) (h : |q|≤r) : |(q:ℝ)|≤(r:ℝ) := by
    rw [←Rat.cast_abs]
    exact Rat.cast_le.mpr h
  rcases raw_inner j hj with ⟨h0,h1,h2,h3,h4⟩
  change |(rawState j 0:ℝ)|≤407/50 ∧ |(rawState j 1:ℝ)|≤33/8 ∧
    |(rawState j 2:ℝ)|≤731/100 ∧ |(rawState j 3:ℝ)|≤731/100 ∧ |(rawState j 4:ℝ)|≤1/100
  exact ⟨by simpa only [Rat.cast_div,Rat.cast_ofNat] using lift _ _ h0,
    by simpa only [Rat.cast_div,Rat.cast_ofNat] using lift _ _ h1,
    by simpa only [Rat.cast_div,Rat.cast_ofNat] using lift _ _ h2,
    by simpa only [Rat.cast_div,Rat.cast_ofNat] using lift _ _ h3,
    by simpa only [Rat.cast_div,Rat.cast_ofNat,Rat.cast_one] using lift _ _ h4⟩

end SolitonClassification.Rotating.Block8Nodes

#print axioms SolitonClassification.Rotating.Block8Nodes.bounds

open Lean Elab Command in
run_cmd do
  for (name, _) in (← getEnv).constants do
    if (`SolitonClassification.Rotating).isPrefixOf name then
      for a in (← collectAxioms name) do
        unless #[`propext,`Classical.choice,`Quot.sound].contains a do
          throwError "Axiom audit failed: {name} depends on {a}"
  logInfo "Block8 concrete leaf audit passed; standard axioms only."
