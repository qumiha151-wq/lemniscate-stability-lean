theorem column5_checked : VariationDataValid mesh 22 Block8Leaf06State.table table5 := by decide +kernel

theorem start5_checked : ∀i : Fin 6,table5.coefficient 0 i=⟨Block8Nodes.matrix 6 5 i,0⟩ := by decide +kernel

theorem endpoint5_checked : evaluateFixedTaylor mesh step table5 22=endpoint5 := by decide +kernel

theorem endpoint5_enclosed (i : Fin 6) : (endpoint5[i.val]).Contains mesh
    ((variationPolynomial (Block8Nodes.state 6) (Block8Nodes.operator 6 (coordinateBasis 5)) 22 i).eval (step:ℝ)) := by
  rw [←endpoint5_checked]
  apply certifiedMixedVariation_endpoint_contains mesh_pos Block8Leaf06State.state_sound (by omega) column5_checked
  intro i
  rw [start5_checked]
  exact Block8Nodes.start_column_contains 6 5 i

def fullEndpoint : Fin 6 → Vector FixedBall 6 := ![endpoint0,endpoint1,endpoint2,endpoint3,endpoint4,endpoint5]

theorem endpoint_enclosed (col i : Fin 6) : (fullEndpoint col)[i.val].Contains mesh
    ((variationPolynomial (Block8Nodes.state 6) (Block8Nodes.operator 6 (coordinateBasis col)) 22 i).eval (step:ℝ)) := by
  fin_cases col
  · exact endpoint0_enclosed i
  · exact endpoint1_enclosed i
  · exact endpoint2_enclosed i
  · exact endpoint3_enclosed i
  · exact endpoint4_enclosed i
  · exact endpoint5_enclosed i

theorem endpoint_center_checked : ∀col i : Fin 6,(fullEndpoint col)[i.val].center=Block8Nodes.matrix 7 col i := by decide +kernel

theorem radius_rows_checked : ∀i : Fin 6,∑col : Fin 6,((fullEndpoint col)[i.val].radius:ℚ)/mesh≤1/10^55 := by decide +kernel

theorem matrix_reset : ‖referencePolynomialMatrix 1 (Block8Nodes.state 6) 22 (Block8Nodes.operator 6) (step:ℝ)-Block8Nodes.operator 7‖≤1/10^55 := by
  have he (col i : Fin 6) : ((fullEndpoint col)[i.val]).Contains mesh
      ((variationPolynomialMap (Block8Nodes.state 6) 22 (step:ℝ)).comp (Block8Nodes.operator 6) (coordinateBasis col) i) := by
    simp only [ContinuousLinearMap.comp_apply,variationPolynomialMap_apply]
    exact endpoint_enclosed col i
  have hc : fixedMatrixMidpoint mesh (fun col i=>(fullEndpoint col)[i.val])=Block8Nodes.operator 7 := by
    simp only [fixedMatrixMidpoint,Block8Nodes.operator,pointMatrixOperator,endpoint_center_checked]
  have h:=fixedMatrixMidpoint_error he (by norm_num) radius_rows_checked
  rw [hc] at h
  simp only [referencePolynomialMatrix,one_mul]
  convert! h using 1
  norm_num

end SolitonClassification.Rotating.Block8Leaf06Matrix

#print axioms SolitonClassification.Rotating.Block8Leaf06Matrix.matrix_reset

