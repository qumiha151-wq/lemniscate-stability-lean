  exact Block8Nodes.start_contains 5 i

theorem endpoint_enclosed (i : Fin 6) : (endpointData[i.val]).Contains mesh
    ((taylorPolynomial (Block8Nodes.state 5) 42 i).eval (step:ℝ)) := by
  rw [←endpoint_checked]
  apply certifiedTable_endpoint_contains mesh_pos table_checked
  intro i
  rw [start_checked]
  exact Block8Nodes.start_contains 5 i

