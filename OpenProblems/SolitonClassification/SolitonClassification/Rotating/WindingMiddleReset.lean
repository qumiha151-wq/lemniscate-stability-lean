def commonDen : ℤ := 16*hd*den^3
def repunit : ℤ := ((2*halfBase)^157-1)/(2*halfBase-1)
def laneOffset : ℤ := 2^748
def mask : ℕ := ((2*laneOffset-1)*repunit).toNat
def good (i : Nat) := Id.run do
