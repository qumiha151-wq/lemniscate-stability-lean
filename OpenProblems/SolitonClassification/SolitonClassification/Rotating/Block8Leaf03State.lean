theorem table_checked : TaylorDataValid mesh 42 table := by decide +kernel

theorem start_checked : ∀i : Fin 6,table.coefficient 0 i=Block8Nodes.startBalls 3 i := by decide +kernel

theorem endpoint_checked : evaluateFixedTaylor mesh step table 42=endpointData := by decide +kernel

theorem state_sound : FixedTaylorInvariant mesh table (Block8Nodes.state 3) 42 := by
  apply table_checked.sound mesh_pos
  intro i
  rw [start_checked]
  exact Block8Nodes.start_contains 3 i

theorem endpoint_enclosed (i : Fin 6) : (endpointData[i.val]).Contains mesh
    ((taylorPolynomial (Block8Nodes.state 3) 42 i).eval (step:ℝ)) := by
  rw [←endpoint_checked]
  apply certifiedTable_endpoint_contains mesh_pos table_checked
  intro i
  rw [start_checked]
  exact Block8Nodes.start_contains 3 i

theorem endpoint_center_checked : ∀i : Fin 6,endpointData[i.val].center=Block8Nodes.centers 4 i := by decide +kernel

