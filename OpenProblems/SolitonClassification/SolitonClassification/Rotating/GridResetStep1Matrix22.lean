theorem start5_checked : ∀i : Fin 6,table5.coefficient 0 i=pointMatrix1 5 i := by decide +kernel

theorem endpoint5_checked : evaluateFixedTaylor mesh step table5 22=endpoint5 := by decide +kernel

theorem endpoint5_enclosed (i : Fin 6) : (endpoint5[i.val]).Contains mesh
    ((variationPolynomial state1 (matrix1 (coordinateBasis 5)) 22 i).eval (step:ℝ)) := by
  rw [←endpoint5_checked]
  apply certifiedMixedVariation_endpoint_contains mesh_pos GridResetStep1State60.state_sound
    (by omega) column5_checked
  intro i
  rw [start5_checked]
  exact pointMatrix1_contains 5 i

run_cmd Lean.logInfo "Second segment full matrix column 5 checked."

def fullEndpoint : Fin 6 → Vector FixedBall 6 := ![endpoint0,endpoint1,endpoint2,endpoint3,endpoint4,endpoint5]

theorem full_matrix_enclosed (j i : Fin 6) : (fullEndpoint j)[i.val].Contains mesh
    ((variationPolynomial state1 (matrix1 (coordinateBasis j)) 22 i).eval (step:ℝ)) := by
  fin_cases j
  · exact endpoint0_enclosed i
  · exact endpoint1_enclosed i
  · exact endpoint2_enclosed i
  · exact endpoint3_enclosed i
  · exact endpoint4_enclosed i
  · exact endpoint5_enclosed i

end SolitonClassification.Rotating.GridResetStep1Matrix22

#print axioms SolitonClassification.Rotating.GridResetStep1Matrix22.full_matrix_enclosed

open Lean Elab Command in
run_cmd do
  for (name, _) in (← getEnv).constants do
    if (`SolitonClassification.Rotating).isPrefixOf name then
      for a in (← collectAxioms name) do
        unless #[`propext,`Classical.choice,`Quot.sound].contains a do
          throwError "Axiom audit failed: {name} depends on {a}"
  logInfo "Second reset-segment finite recurrence and endpoint audit passed."
