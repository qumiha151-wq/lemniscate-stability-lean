def timePlus : FixedBall := ⟨75526542470371316453193342209024071053112835144215620586701583, 2500000000000000000000000000001⟩
def timeMinus : FixedBall := ⟨-75526542470371316453193342209024071053112835144215620586701584, 2500000000000000000000000000001⟩

def polynomialBox (tb : FixedBall) : Vector FixedBall 6 :=
  Vector.ofFn fun i =>
    fixedHorner scale tb (fun j => coefficientTable.coefficient j i) 0 61

def positivePolynomial : Vector FixedBall 6 := ⟨#[⟨77524058039166230851692687430382861373847661816742205833530719286, 10635288961681996850260618646892257⟩,
    ⟨-2212477459917916796218482223157413387547458503644858775954267565, 10964525026282434418926473810224059⟩,
    ⟨1635359411305979628702442191838211329366856273340116696104375202, 10615019813461874908309230379838144⟩,
    ⟨-886608256573035797486772067941409086795866347965189196480302854, 10622195492545738802809819723484560⟩,
