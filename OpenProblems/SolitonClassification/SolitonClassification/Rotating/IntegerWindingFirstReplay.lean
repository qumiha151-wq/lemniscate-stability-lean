    ⟨1064442552746222511532993784666235377989403181867151006535440126, 10000000000000000000000000000000003⟩,
    ⟨-585853292141568540468376395606464470626328131082279201665091024, 97278330338521288987523738913496⟩], rfl⟩

theorem checked_input : ∀i : Fin 6, coefficientTable.coefficient 0 i = firstInputs[i.val] := by
  decide +kernel
theorem positive_replay : polynomialBox timePlus = positivePolynomial := by
  have h : ∀i : Fin 6, (polynomialBox timePlus)[i.val] = positivePolynomial[i.val] := by decide +kernel
  exact Vector.ext fun i hi => h ⟨i,hi⟩
theorem negative_replay : polynomialBox timeMinus = negativePolynomial := by
  have h : ∀i : Fin 6, (polynomialBox timeMinus)[i.val] = negativePolynomial[i.val] := by decide +kernel
  exact Vector.ext fun i hi => h ⟨i,hi⟩

end SolitonClassification.Rotating.IntegerWinding

#print axioms SolitonClassification.Rotating.IntegerWinding.positive_replay
