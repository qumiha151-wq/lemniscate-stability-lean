theorem matrix_reset :
    ‖(variationPolynomialMap initial 22 (step:ℝ)).comp Grid42P00Nodes.startOperator-Grid42P00Nodes.nextOperator‖≤1/10^57 := by
  have he (j i : Fin 6) : ((fullEndpoint j)[i.val]).Contains mesh
      ((variationPolynomialMap initial 22 (step:ℝ)).comp Grid42P00Nodes.startOperator (coordinateBasis j) i) := by
    simp only [ContinuousLinearMap.comp_apply,variationPolynomialMap_apply]
    exact endpoint_enclosed j i
  have hc : fixedMatrixMidpoint mesh (fun j i=>(fullEndpoint j)[i.val])=Grid42P00Nodes.nextOperator := by
    simp only [fixedMatrixMidpoint,Grid42P00Nodes.nextOperator,pointMatrixOperator,endpoint_center_checked]
  have h:=fixedMatrixMidpoint_error he (by norm_num) radius_rows_checked
  rw [hc] at h
  convert! h using 1
  norm_num

