theorem start_identity : startOperator=1 := by
  have hb (j : Fin 6) : startOperator (coordinateBasis j)=coordinateBasis j := by
    ext i
    change pointMatrixOperator mesh startMatrix (coordinateBasis j) i=coordinateBasis j i
    rw [pointMatrixOperator_basis]
    fin_cases j <;> fin_cases i <;> norm_num [startMatrix,mesh,coordinateBasis]
  apply ContinuousLinearMap.ext
  intro v
  change startOperator v=v
  conv_lhs => rw [state_basis_expansion v]
  simp only [map_sum,map_smul,hb]
  exact (state_basis_expansion v).symm

theorem start_column_contains (j i : Fin 6) :
    (⟨startMatrix j i,0⟩:FixedBall).Contains mesh (startOperator (coordinateBasis j) i) := by
  change (⟨startMatrix j i,0⟩:FixedBall).Contains mesh (pointMatrixOperator mesh startMatrix (coordinateBasis j) i)
  rw [pointMatrixOperator_basis]
  simp [FixedBall.Contains,FixedBall.toRational,RationalBall.Contains]

