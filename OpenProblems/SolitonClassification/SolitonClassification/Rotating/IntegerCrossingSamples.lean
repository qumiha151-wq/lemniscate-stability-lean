def sample (i : Fin 36) : Sample := (![row1807,row1808,row1809,row1810,row1811,row1812,row1813,row1814,row1815,row2204,row2205,row2206,row2207,row2208,row2209,row2210,row2211,row2212,row1684,row1685,row1686,row1687,row1688,row1689,row1690,row1691,row1692,row2395,row2396,row2397,row2398,row2399,row2400,row2401,row2402,row2403] : Fin 36→Sample) i

theorem basic (i : Fin 36) : let r:=sample i
    r.index<4000 ∧ |r.theta|≤5 ∧ |r.p|+|r.q|≤12 ∧
    |rationalState (GridPlus.atNode r.index) 2-r.p|≤1/10^8 ∧
    |rationalState (GridPlus.atNode r.index) 3-r.q|≤1/10^8 ∧
    |rationalState (GridPlus.atNode r.index) 5-r.theta|≤1/10^8 ∧
    |cv r 0-(1-(r.theta/2048)^2/2)|≤1/10^14 ∧
    |sv r 0-(r.theta/2048-(r.theta/2048)^3/6)|≤1/10^14 ∧
    |r.q*cv r 11-r.p*sv r 11-r.x|≤1/10^6 ∧
    |r.q*sv r 11+r.p*cv r 11-r.y|≤1/10^6 := by
  revert i; decide +kernel
theorem norms : ∀i:Fin 36,∀j:Fin 12, |cv (sample i) j.val|≤1 ∧ |sv (sample i) j.val|≤1 := by decide +kernel
theorem stages : ∀i:Fin 36,∀j:Fin 11, let r:=sample i
    |cv r (j.val+1)-((cv r j.val)^2-(sv r j.val)^2)|≤1/10^14 ∧
    |sv r (j.val+1)-2*sv r j.val*cv r j.val|≤1/10^14 := by decide +kernel

def angles (i : Fin 36) : DoubleAngles (sample i).theta :=
  let r:=sample i
  let b:=basic i
  ⟨cv r,sv r,b.2.1,b.2.2.2.2.2.2.1,b.2.2.2.2.2.2.2.1,
   fun j hj=>(norms i ⟨j,by omega⟩).1,fun j hj=>(norms i ⟨j,by omega⟩).2,
   fun j hj=>(stages i ⟨j,hj⟩).1,fun j hj=>(stages i ⟨j,hj⟩).2⟩
end
end SolitonClassification.Rotating.IntegerTarget.CrossingCharts
