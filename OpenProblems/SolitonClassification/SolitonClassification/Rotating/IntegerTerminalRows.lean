def lanes (n : Node) : Data := fun j => [(n[j]?).getD 0]
def rationalState (n : Node) : Fin 6 → ℚ := fun j => ((n[j.val]?).getD 0:ℚ)/nodeGrid
def rationalColumn (n : Node) (j i : Fin 5) : ℚ :=
  (forwardNode n j.castSucc (physicalIndex i):ℚ)/commonGrid

theorem initial_coordinate : shootingInitial phase center =
    IntegerWinding.initial (fun i => (IntegerWinding.center i:ℝ)) := by
  have c : center=(fun i => (IntegerWinding.center i:ℝ)) := by
    have h : ∀i, centerQ i=IntegerWinding.center i := by decide +kernel
    exact funext fun i => congrArg (fun r : ℚ => (r:ℝ)) (h i)
  have e : phase 0=(IntegerWinding.phaseE:ℝ) := congrArg (fun r : ℚ => (r:ℝ))
    (by decide +kernel : phaseQ 0=IntegerWinding.phaseE)
  have g : phase 1=(IntegerWinding.phaseG:ℝ) := congrArg (fun r : ℚ => (r:ℝ))
    (by decide +kernel : phaseQ 1=IntegerWinding.phaseG)
  rw [shootingInitial_apply,c,e,g]
  ext i
  fin_cases i <;> rfl

theorem terminal_identification {p : Data} {z : Node}
    (h : ∀j : ℕ, (p j).sum=(z[j]?).getD 0) :
    path p d 1=realState (rationalState z) ∧
      matrixPath p 1=pointMatrixOperator commonGrid (forwardNode z) := by
  have h0 : ∀j : ℕ, ((lanes z j).head?.getD 0)=(z[j]?).getD 0 := by intro j; rfl
  have adj := matrixPath_join (q:=lanes z) (fun i => (h i).trans (h0 i).symm)
  refine ⟨adj.1.trans ?_,adj.2.trans (matrixPath_zero_eq h0)⟩
  ext i
  change eval 0 (lanes z i.val)/(d:ℝ)=_
  rw [eval_zero,h0]
  simp [realState,rationalState,d,Middle.den,nodeGrid]

theorem numbers_of_nodes {n : ℤ} (T : PolynomialTape n 4000) (q : Fin 6 → ℚ)
    (cols : ParameterMatrix) (z : Node) (stepSmall : |step n|≤1/125)
    (start : T.node 0=initialNode)
    (last : ∀j : ℕ,(T.data 3999 j).sum=(z[j]?).getD 0)
    (stateEq : ∀i, rationalState z i=q i)
    (colEq : ∀j i,rationalColumn z j i=cols j i)
    (rowBound : ∀i,∑j : Fin 6, |forwardNode z j i|≤5000*(commonGrid:ℤ))
    (size : ∀j,|q j|≤8) : TapeNumbers T q cols := by
  have init (j : ℕ) : ((T.data 0 j).head?.getD 0)=(initialNode[j]?).getD 0 := by
    rw [T.initial 0 (by decide),start]
  have initP (j : ℕ) := PrefixPlus.tape.initial 0 (by decide) j
  have original : path (T.data 0) d 0=path (PrefixPlus.tape.data 0) d 0 := by
    ext i
    change eval 0 _ / (d:ℝ)=eval 0 _ / (d:ℝ)
    rw [eval_zero,eval_zero,init,initP]
    rfl
  have M0 : matrixPath (T.data 0) 0=1 := by
    rw [matrixPath_zero_eq init]
    exact (matrixPath_zero_eq initP).symm.trans PrefixPlus.at_zero
  obtain ⟨estate,ematrix⟩ := terminal_identification last
  refine ⟨stepSmall,M0,?_,estate.trans (congrArg realState (funext stateEq)),size,?_,?_⟩
  · rw [initial_coordinate,original]
    exact PrefixPlus.centre_seed
  · rw [ematrix]
    have h := pointMatrixOperator_norm (S:=commonGrid) (by decide +kernel) (forwardNode z)
      (by decide +kernel : 0≤5000*(commonGrid:ℤ)) rowBound
    exact h.trans (by norm_num [commonGrid,nodeGrid,invGrid])
  · intro j i
    rw [ematrix,←colEq]
    have beq : basisVector (n:=6) j.castSucc=coordinateBasis j.castSucc := by
      ext l; simp only [basisVector,coordinateBasis,eq_comm]
    rw [beq,pointMatrixOperator_basis]
    simp [rationalColumn]

theorem plus_numbers (T : PolynomialTape Middle.hn 4000)
    (start : T.node 0=initialNode)
    (last : ∀j : ℕ,(T.data 3999 j).sum=(plusNode[j]?).getD 0) :
    TapeNumbers T plusQ plusColumn :=
  numbers_of_nodes T plusQ plusColumn plusNode (signedHalfSteps true)
    start last (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)

theorem minus_numbers (T : PolynomialTape (-Middle.hn) 4000)
    (start : T.node 0=initialNode)
    (last : ∀j : ℕ,(T.data 3999 j).sum=(minusNode[j]?).getD 0) :
    TapeNumbers T minusQ minusColumn :=
  numbers_of_nodes T minusQ minusColumn minusNode (signedHalfSteps false)
    start last (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)

end
end SolitonClassification.Rotating.IntegerTarget
#print axioms SolitonClassification.Rotating.IntegerTarget.plus_numbers
