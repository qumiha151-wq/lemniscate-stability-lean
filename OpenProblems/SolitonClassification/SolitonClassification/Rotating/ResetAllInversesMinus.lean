theorem projection (b : ℕ) (hb : b<63) :
    (block b).map Entry.node = GridMinus.chunk b := by interval_cases b <;> decide +kernel
theorem length (b : ℕ) (hb : b<63) :
    (block b).size = if b<62 then 64 else 33 := by interval_cases b <;> rfl
theorem every_node (i : ℕ) (hi : i≤4000) : ∃ w, CheckedNode (GridMinus.atNode i) w := by
  have hb : i/64<63 := by omega
  have len : i%64<(block (i/64)).size := by
    rw [length _ hb]; split <;> omega
  let e := (block (i/64))[i%64]
  refine ⟨e.inv,?_⟩
  have eq : GridMinus.atNode i = e.node := by
    rw [GridMinus.atNode,←projection _ hb,Array.getElem?_map,Array.getElem?_eq_getElem len]
    rfl
  exact eq.symm ▸ e.verified
end SolitonClassification.Rotating.DyadicReset.AllInversesMinus
