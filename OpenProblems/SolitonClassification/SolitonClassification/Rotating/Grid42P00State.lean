theorem table_checked : TaylorDataValid mesh 42 table := by decide +kernel

theorem start_checked : ∀i : Fin 6,table.coefficient 0 i=initialBalls i := by decide +kernel

theorem endpoint_checked : evaluateFixedTaylor mesh step table 42=endpointData := by decide +kernel

theorem state_sound : FixedTaylorInvariant mesh table initial 42 := by
  apply table_checked.sound mesh_pos
  intro i
  rw [start_checked]
  exact initial_enclosed i

theorem endpoint_enclosed (i : Fin 6) : (endpointData[i.val]).Contains mesh
    ((taylorPolynomial initial 42 i).eval (step:ℝ)) := by
  rw [←endpoint_checked]
  apply certifiedTable_endpoint_contains mesh_pos table_checked
  intro i
  rw [start_checked]
  exact initial_enclosed i

theorem endpoint_center_checked : ∀i : Fin 6,endpointData[i.val].center=Grid42P00Nodes.nextCenters i := by decide +kernel

theorem radius_checked : ∀i : Fin 6,(endpointData[i.val].radius:ℚ)/mesh≤1/10^57 := by decide +kernel

theorem state_reset : ‖polynomialPath (taylorPolynomial initial 42) (step:ℝ)-Grid42P00Nodes.nextState‖≤1/10^57 := by
  have he : fixedStateMidpoint mesh (fun i=>endpointData[i.val])=Grid42P00Nodes.nextState := by
    funext i
    simp only [fixedStateMidpoint,Grid42P00Nodes.nextState,Grid42P00Nodes.rawNextState,endpoint_center_checked]
  have h:=fixedStateMidpoint_error endpoint_enclosed (by norm_num) radius_checked
  rw [he] at h
  convert! h using 1
  norm_num

end SolitonClassification.Rotating.Grid42P00State

