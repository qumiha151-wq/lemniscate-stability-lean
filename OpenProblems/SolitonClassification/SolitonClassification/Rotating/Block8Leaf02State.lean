theorem table_checked : TaylorDataValid mesh 42 table := by decide +kernel

theorem start_checked : ∀i : Fin 6,table.coefficient 0 i=Block8Nodes.startBalls 2 i := by decide +kernel

theorem endpoint_checked : evaluateFixedTaylor mesh step table 42=endpointData := by decide +kernel

theorem state_sound : FixedTaylorInvariant mesh table (Block8Nodes.state 2) 42 := by
  apply table_checked.sound mesh_pos
  intro i
  rw [start_checked]
  exact Block8Nodes.start_contains 2 i

theorem endpoint_enclosed (i : Fin 6) : (endpointData[i.val]).Contains mesh
    ((taylorPolynomial (Block8Nodes.state 2) 42 i).eval (step:ℝ)) := by
  rw [←endpoint_checked]
  apply certifiedTable_endpoint_contains mesh_pos table_checked
  intro i
  rw [start_checked]
  exact Block8Nodes.start_contains 2 i

theorem endpoint_center_checked : ∀i : Fin 6,endpointData[i.val].center=Block8Nodes.centers 3 i := by decide +kernel

theorem radius_checked : ∀i : Fin 6,(endpointData[i.val].radius:ℚ)/mesh≤1/10^55 := by decide +kernel

theorem state_reset : ‖polynomialPath (taylorPolynomial (Block8Nodes.state 2) 42) (step:ℝ)-Block8Nodes.state 3‖≤1/10^55 := by
  have he : fixedStateMidpoint mesh (fun i=>endpointData[i.val])=Block8Nodes.state 3 := by
    funext i
    change (((endpointData[i.val].center:ℚ)/mesh:ℚ):ℝ)=(((Block8Nodes.centers 3 i:ℚ)/mesh:ℚ):ℝ)
    rw [endpoint_center_checked]
  have h:=fixedStateMidpoint_error endpoint_enclosed (by norm_num) radius_checked
  rw [he] at h
  convert! h using 1
  norm_num

