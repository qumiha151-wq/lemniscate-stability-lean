def physicalIndex : Fin 5 → Fin 6 := ![0,1,2,3,5]
def physicalWeight : Fin 5 → ℚ := ![1,8,1,1,1]

def endpointField (z : Fin 6 → ℚ) : Fin 6 → ℚ :=
  ![8*z 1,-(z 0)^3/16-z 2/8-z 4*z 3/8,-z 0*z 3,1+z 0*z 2,0,z 0]

def jacobianQ (i : Fin 5) : Fin 5 → ℚ :=
  let v := fun j => plusColumn j i-minusColumn j i
  let k := physicalIndex i
  fun j => physicalWeight i *
    (![v 0,v 2,endpointField plusQ k+endpointField minusQ k,
       v 1*phaseQ 0/8+v 3*phaseQ 1,v 4] : Fin 5 → ℚ) j

def residualQ (i : Fin 5) : ℚ :=
  physicalWeight i*(plusQ (physicalIndex i)-minusQ (physicalIndex i))+
    (![0,0,0,0,2*piFloor] : Fin 5 → ℚ) i

theorem inverse_bound : ‖parameterMatrixOperator inverseQ‖ ≤ 13 := by
  exact_mod_cast parameterMatrixOperator_norm_le inverseQ (C := 13) (by decide) (by decide +kernel)

theorem defect_bound : ‖ContinuousLinearMap.id ℝ Parameters-
    (parameterMatrixOperator inverseQ).comp (parameterMatrixOperator jacobianQ)‖ ≤
    1/(10:ℝ)^12 := by
  have h := parameterMatrixOperator_defect_norm inverseQ jacobianQ
    (q := 1/10^12) (by norm_num) (by decide +kernel)
  push_cast at h
  exact h

theorem residual_bound : ‖(fun i => (residualQ i:ℝ) : Parameters)‖ ≤ 1/(10:ℝ)^40 := by
  rw [pi_norm_le_iff_of_nonneg (by positivity)]
  intro i
  have hr : ∀ j, |residualQ j| ≤ (1:ℚ)/10^40 := by decide +kernel
  simpa only [Real.norm_eq_abs,Rat.cast_abs,Rat.cast_div,Rat.cast_one,
    Rat.cast_pow,Rat.cast_ofNat] using (Rat.cast_le (K := ℝ)).mpr (hr i)
end
