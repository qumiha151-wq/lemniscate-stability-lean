theorem table_checked : TaylorDataValid mesh 42 table := by decide +kernel

theorem start_checked : ∀i : Fin 6,table.coefficient 0 i=Block16Nodes.startBalls 8 i := by decide +kernel

theorem endpoint_checked : evaluateFixedTaylor mesh step table 42=endpointData := by decide +kernel

theorem state_sound : FixedTaylorInvariant mesh table (Block16Nodes.state 8) 42 := by
  apply table_checked.sound mesh_pos
  intro i
  rw [start_checked]
  exact Block16Nodes.start_contains 8 i

theorem endpoint_enclosed (i : Fin 6) : (endpointData[i.val]).Contains mesh
    ((taylorPolynomial (Block16Nodes.state 8) 42 i).eval (step:ℝ)) := by
  rw [←endpoint_checked]
  apply certifiedTable_endpoint_contains mesh_pos table_checked
  intro i
  rw [start_checked]
  exact Block16Nodes.start_contains 8 i

theorem endpoint_center_checked : ∀i : Fin 6,endpointData[i.val].center=Block16Nodes.centers 9 i := by decide +kernel

theorem radius_checked : ∀i : Fin 6,(endpointData[i.val].radius:ℚ)/mesh≤1/10^55 := by decide +kernel

theorem state_reset : ‖polynomialPath (taylorPolynomial (Block16Nodes.state 8) 42) (step:ℝ)-Block16Nodes.state 9‖≤1/10^55 := by
  have he : fixedStateMidpoint mesh (fun i=>endpointData[i.val])=Block16Nodes.state 9 := by
    funext i
    change (((endpointData[i.val].center:ℚ)/mesh:ℚ):ℝ)=(((Block16Nodes.centers 9 i:ℚ)/mesh:ℚ):ℝ)
    rw [endpoint_center_checked]
  have h:=fixedStateMidpoint_error endpoint_enclosed (by norm_num) radius_checked
  rw [he] at h
  convert! h using 1
  norm_num

