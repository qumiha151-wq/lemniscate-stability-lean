def endpointBall (k : Fin 5) (i : Fin 7) : RationalBall :=
  (((endpointVectors k)[i.val]).toRational mesh).inflate (1/10^43)
def centerOutput : RationalVector3 := projectedRationalCenter (endpointBall 0)
def plusOutput (i : Fin 2) : RationalVector3 := projectedRationalCenter (endpointBall (![1,3] i))
def minusOutput (i : Fin 2) : RationalVector3 := projectedRationalCenter (endpointBall (![2,4] i))
def timeBalls : BallVector := evaluateWeightedField mesh (endpointBall 0)
def proposedJacobian : RationalMatrix3 := fivePathRationalJacobian delta plusOutput minusOutput
  (projectedRationalCenter timeBalls)
