theorem parameter_bounds : (1:ℚ)≤parameters 2 ∧ parameters 2+1/16000≤15/2 := by decide +kernel
theorem endpoint_widths : ∀ k : Fin 5, checkProjectedRadius (endpointBall k) outputAllowance=true := by decide +kernel
theorem time_column_width : checkProjectedRadius timeBalls outputAllowance=true := by decide +kernel
theorem preconditioner_bound : checkRationalMatrixBound preconditioner 2=true := by decide +kernel
theorem inverse_defect : checkRationalMatrixBound (rationalIdentity3-rationalMatrixProduct preconditioner proposedJacobian) (1/10^9)=true := by decide +kernel
theorem center_residual : checkRationalVectorBound (rationalMatrixVector preconditioner centerOutput) (1/10^35)=true := by decide +kernel
