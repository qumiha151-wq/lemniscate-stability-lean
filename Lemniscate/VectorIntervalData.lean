def trialPairingInput : Interval :=
  ⟨∑ j : Fin 18, (scale (rotationCoefficientData j) (adjointTrialCoefficient j)).lo,
   ∑ j : Fin 18, (scale (rotationCoefficientData j) (adjointTrialCoefficient j)).hi⟩

def rotationFiniteNormSquaredInput : Interval :=
  ⟨∑ j : Fin 15, (mul (rotationCoefficientData (Fin.castAdd 3 j)) (rotationCoefficientData (Fin.castAdd 3 j))).lo,
   ∑ j : Fin 15, (mul (rotationCoefficientData (Fin.castAdd 3 j)) (rotationCoefficientData (Fin.castAdd 3 j))).hi⟩

def adjointFinitePairingInput : Interval :=
  ⟨∑ j : Fin 15, (mul (adjointCoefficientData (Fin.castAdd 3 j)) (rotationFiniteData j)).lo,
   ∑ j : Fin 15, (mul (adjointCoefficientData (Fin.castAdd 3 j)) (rotationFiniteData j)).hi⟩

structure VectorIntervalCertificate : Prop where
  r_pos : 0 < (scale ⟨thetaRLower,thetaRUpper⟩ 5).lo
  norm_pos : 0 < rotationNormData.lo
  norm_hi_pos : 0 < rotationNormData.hi
  norm_lower : rotationNormData.lo^2 ≤ rotationNormSquaredInput.lo
  norm_upper : rotationNormSquaredInput.hi ≤ rotationNormData.hi^2
  coefficients : ∀ j : Fin 18, Encloses (rotationCoefficientData j)
    (dividePositive (scale (fineCoefficientData (j.val+1)) (2*(j.val+1:ℕ))) rotationNormData)
  pair : Encloses trialPairingData trialPairingInput
  pair_pos : 0 < trialPairingData.lo
  adjoint_coefficients : ∀ j : Fin 18, Encloses (adjointCoefficientData j)
    (dividePositive (point (adjointTrialCoefficient j)) trialPairingData)
  finite_norm_pos : (999/1000:ℚ) < rotationFiniteNormData.lo
  finite_norm_hi_pos : 0 < rotationFiniteNormData.hi
  finite_norm_lower : rotationFiniteNormData.lo^2 ≤ rotationFiniteNormSquaredInput.lo
  finite_norm_upper : rotationFiniteNormSquaredInput.hi ≤ rotationFiniteNormData.hi^2
  rotation_finite : ∀ j : Fin 15, Encloses (rotationFiniteData j)
    (dividePositive (rotationCoefficientData (Fin.castAdd 3 j)) rotationFiniteNormData)
  finite_pair : Encloses adjointFinitePairingData adjointFinitePairingInput
  finite_pair_pos : (999/1000:ℚ) < adjointFinitePairingData.lo
  adjoint_finite : ∀ j : Fin 15, Encloses (adjointFiniteData j)
    (dividePositive (adjointCoefficientData (Fin.castAdd 3 j)) adjointFinitePairingData)
  difference_finite : ∀ j : Fin 15, Encloses (differenceFiniteData j)
    (add (adjointFiniteData j) (scale (rotationFiniteData j) (-1)))
  sqrt_two_pos : 0 < sqrtTwoData.lo
  sqrt_two_hi_pos : 0 < sqrtTwoData.hi
  sqrt_two_lower : sqrtTwoData.lo^2 ≤ 2
  sqrt_two_upper : 2 ≤ sqrtTwoData.hi^2

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem vector_interval_certificate : VectorIntervalCertificate := by
  constructor <;> decide +kernel

end Lemniscate.CoarseArithmetic
