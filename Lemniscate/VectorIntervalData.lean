def Encloses (outer inner : Interval) : Prop := outer.lo ≤ inner.lo ∧ inner.hi ≤ outer.hi

instance (outer inner : Interval) : Decidable (Encloses outer inner) :=
  inferInstanceAs (Decidable (outer.lo ≤ inner.lo ∧ inner.hi ≤ outer.hi))

