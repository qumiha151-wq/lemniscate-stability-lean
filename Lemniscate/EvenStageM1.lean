def evenStageM1IntegerMatrix (i j : Fin 31) : IntegerInterval :=
  ((evenStageM1Data.getD i.val #[]).getD j.val ⟨0,0⟩)
def evenStageM1Matrix : Matrix (Fin 31) (Fin 31) Interval := integerMatrixInterval evenStageM1IntegerMatrix
