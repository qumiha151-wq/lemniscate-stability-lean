def evenStageH1IntegerMatrix (i j : Fin 31) : IntegerInterval :=
  ((evenStageH1Data.getD i.val #[]).getD j.val ⟨0,0⟩)
def evenStageH1Matrix : Matrix (Fin 31) (Fin 31) Interval := integerMatrixInterval evenStageH1IntegerMatrix
def evenStageH1Computed : Matrix (Fin 31) (Fin 31) IntegerInterval := integerMatrixSymmetricPart evenStageM1IntegerMatrix
noncomputable def evenStageH1Real : Matrix (Fin 31) (Fin 31) ℝ := Lemniscate.realHeadHermitianPart evenStageM1Real
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem even_stage_h1_comparison : ∀ i j,
    IntegerEncloses (evenStageH1IntegerMatrix i j) (evenStageH1Computed i j) := by
  unfold IntegerEncloses
  decide +kernel
theorem even_stage_h1_sound : MatrixContains evenStageH1Matrix evenStageH1Real :=
  integer_matrix_enlargement _ _ _ even_stage_h1_comparison
    (integer_matrix_symmetric_part_sound _ _ even_stage_m1_sound)
end Lemniscate.CoarseArithmetic
