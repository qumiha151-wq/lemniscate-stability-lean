theorem even_stage_r_comparison : ∀ i j,
    IntegerEncloses (evenStageRIntegerMatrix i j) (evenStageRComputed i j) := by
  unfold IntegerEncloses
  decide +kernel
theorem even_stage_r_sound : MatrixContains evenStageRMatrix evenStageRReal :=
  integer_matrix_enlargement _ _ _ even_stage_r_comparison
    (integer_matrix_mul_sound _ _ _ _ even_seed_ti_sound even_seed_u_sound)
