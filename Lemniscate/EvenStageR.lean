def evenStageRIntegerMatrix (i j : Fin 31) : IntegerInterval :=
  ((evenStageRData.getD i.val #[]).getD j.val ⟨0,0⟩)
def evenStageRMatrix : Matrix (Fin 31) (Fin 31) Interval := integerMatrixInterval evenStageRIntegerMatrix
def evenStageRComputed : Matrix (Fin 31) (Fin 31) IntegerInterval := integerMatrixMul evenSeedTiIntegerMatrix evenSeedUIntegerMatrix
noncomputable def evenStageRReal : Matrix (Fin 31) (Fin 31) ℝ := (Lemniscate.realFiniteNeutralInv)*(Lemniscate.realFiniteHouseholder)
set_option maxRecDepth 100000 in
