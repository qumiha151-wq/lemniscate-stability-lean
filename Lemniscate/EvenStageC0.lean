def evenStageC0IntegerMatrix (i j : Fin 31) : IntegerInterval :=
  ((evenStageC0Data.getD i.val #[]).getD j.val ⟨0,0⟩)
def evenStageC0Matrix : Matrix (Fin 31) (Fin 31) Interval := integerMatrixInterval evenStageC0IntegerMatrix
def evenStageC0Computed : Matrix (Fin 31) (Fin 31) IntegerInterval := integerMatrixAdd evenStageMain0IntegerMatrix evenStageV0PIntegerMatrix
