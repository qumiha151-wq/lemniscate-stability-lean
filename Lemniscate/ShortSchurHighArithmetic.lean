theorem short_d4_comparison : ∀ i k, IntegerEncloses (shortD4Data i k)
    (((fun i k => integerMul (integerPoint (shortHighScale k)) (shortSelectedCrossData 4 i k))) i k) := by
  unfold IntegerEncloses
  decide +kernel

def shortEData : Fin 5 → Matrix (Fin 22) (Fin 22) IntegerInterval :=
  ![shortE0Data,shortE1Data,shortE2Data,shortE3Data,shortE4Data]
def shortDData : Fin 5 → Matrix (Fin 7) (Fin 22) IntegerInterval :=
  ![shortD0Data,shortD1Data,shortD2Data,shortD3Data,shortD4Data]
def shortFiniteCrossSquare (j : Fin 5) : ℚ :=
  ∑ i : Fin 7, ∑ k : Fin 22, (absUpper ((shortDData j i k).toInterval))^2
def shortFiniteHighRow (j : Fin 5) (i : Fin 22) : ℚ :=
  let M := integerMatrixInterval (shortEData j)
  (M i i).hi + (∑ k : Fin 22, if k=i then 0 else absUpper (M i k)) +
    if (shortHighHalfFrequency i).natAbs≤7 then shortInsideRowTail else
      2*shortHighOffCoefficient*tail1 qb (15-(shortHighHalfFrequency i).natAbs)
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem short_finite_cross_square_bound : ∀ j, shortFiniteCrossSquare j+shortCrossTailSquare < (1/16:ℚ) := by
  decide +kernel
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem short_finite_high_rows : ∀ j i, shortFiniteHighRow j i < -(5/4:ℚ) := by
  decide +kernel
