def evenStageZ2IntegerMatrix (i j : Fin 31) : IntegerInterval :=
  ((evenStageZ2Data.getD i.val #[]).getD j.val ⟨0,0⟩)
def evenStageZ2Matrix : Matrix (Fin 31) (Fin 31) Interval := integerMatrixInterval evenStageZ2IntegerMatrix
def evenStageZ2Computed : Matrix (Fin 31) (Fin 31) IntegerInterval := integerMatrixMul (integerMatrixTranspose evenSeedP0IntegerMatrix) evenStageH2IntegerMatrix
noncomputable def evenStageZ2Real : Matrix (Fin 31) (Fin 31) ℝ := ((Lemniscate.realFiniteAnchorProjection))ᵀ*evenStageH2Real
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem even_stage_z2_comparison : ∀ i j,
    IntegerEncloses (evenStageZ2IntegerMatrix i j) (evenStageZ2Computed i j) := by
  unfold IntegerEncloses
  decide +kernel
theorem even_stage_z2_sound : MatrixContains evenStageZ2Matrix evenStageZ2Real :=
  integer_matrix_enlargement _ _ _ even_stage_z2_comparison
    (integer_matrix_mul_sound _ _ _ _ (integer_matrix_transpose_sound _ _ even_seed_p0_sound) even_stage_h2_sound)
end Lemniscate.CoarseArithmetic
