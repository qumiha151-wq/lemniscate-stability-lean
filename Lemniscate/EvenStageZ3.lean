def evenStageZ3IntegerMatrix (i j : Fin 31) : IntegerInterval :=
  ((evenStageZ3Data.getD i.val #[]).getD j.val ⟨0,0⟩)
def evenStageZ3Matrix : Matrix (Fin 31) (Fin 31) Interval := integerMatrixInterval evenStageZ3IntegerMatrix
def evenStageZ3Computed : Matrix (Fin 31) (Fin 31) IntegerInterval := integerMatrixMul (integerMatrixTranspose evenSeedP0IntegerMatrix) evenStageH3IntegerMatrix
noncomputable def evenStageZ3Real : Matrix (Fin 31) (Fin 31) ℝ := ((Lemniscate.realFiniteAnchorProjection))ᵀ*evenStageH3Real
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem even_stage_z3_comparison : ∀ i j,
    IntegerEncloses (evenStageZ3IntegerMatrix i j) (evenStageZ3Computed i j) := by
  unfold IntegerEncloses
  decide +kernel
theorem even_stage_z3_sound : MatrixContains evenStageZ3Matrix evenStageZ3Real :=
  integer_matrix_enlargement _ _ _ even_stage_z3_comparison
    (integer_matrix_mul_sound _ _ _ _ (integer_matrix_transpose_sound _ _ even_seed_p0_sound) even_stage_h3_sound)
