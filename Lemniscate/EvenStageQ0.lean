theorem even_stage_q0_comparison : ∀ i j,
    IntegerEncloses (evenStageQ0IntegerMatrix i j) (evenStageQ0Computed i j) := by
  unfold IntegerEncloses
  decide +kernel
theorem even_stage_q0_sound : MatrixContains evenStageQ0Matrix evenStageQ0Real :=
  integer_matrix_enlargement _ _ _ even_stage_q0_comparison
    (integer_matrix_mul_sound _ _ _ _ (integer_matrix_transpose_sound _ _ even_seed_u_sound) even_seed_a0_sound)
