def evenStageV2IntegerMatrix (i j : Fin 31) : IntegerInterval :=
  ((evenStageV2Data.getD i.val #[]).getD j.val ⟨0,0⟩)
def evenStageV2Matrix : Matrix (Fin 31) (Fin 31) Interval := integerMatrixInterval evenStageV2IntegerMatrix
def evenStageV2Computed : Matrix (Fin 31) (Fin 31) IntegerInterval := integerMatrixMul (integerMatrixTranspose evenSeedPIntegerMatrix) evenStageH2IntegerMatrix
noncomputable def evenStageV2Real : Matrix (Fin 31) (Fin 31) ℝ := ((Lemniscate.realFiniteStableProjection))ᵀ*evenStageH2Real
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem even_stage_v2_comparison : ∀ i j,
    IntegerEncloses (evenStageV2IntegerMatrix i j) (evenStageV2Computed i j) := by
  unfold IntegerEncloses
  decide +kernel
theorem even_stage_v2_sound : MatrixContains evenStageV2Matrix evenStageV2Real :=
  integer_matrix_enlargement _ _ _ even_stage_v2_comparison
    (integer_matrix_mul_sound _ _ _ _ (integer_matrix_transpose_sound _ _ even_seed_p_sound) even_stage_h2_sound)
