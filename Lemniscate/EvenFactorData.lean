def evenFactorLower (k : Fin 5) (i j : Fin 31) : ℚ :=
  (((evenFactorLowerData.getD k.val #[]).getD i.val #[]).getD j.val 0)
def evenFactorDiagonal (k : Fin 5) (i : Fin 31) : ℚ :=
  (evenFactorDiagonalData.getD k.val #[]).getD i.val 0
def evenBernsteinInterval (k : Fin 5) (i j : Fin 31) : Interval :=
  (((evenBernsteinIntervalData.getD k.val #[]).getD i.val #[]).getD j.val (point 0))
def evenFactorPenalty (i : Fin 31) : ℚ := evenFactorPenaltyData.getD i.val 0
def evenFactorCorrection (k : Fin 5) (i j : Fin 31) : ℚ :=
  (∑ r : Fin 31, evenFactorLower k i r*evenFactorDiagonal k r*evenFactorLower k j r)+
    (if i = j then evenFactorPenalty i+2 else 0)
def evenFactorRowBound (k : Fin 5) (i : Fin 31) : ℚ :=
  ∑ j : Fin 31, absUpper (add (evenBernsteinInterval k i j)
    (point (evenFactorCorrection k i j)))

end Lemniscate.CoarseArithmetic
