theorem even_stage_z2p_comparison : ∀ i j,
    IntegerEncloses (evenStageZ2PIntegerMatrix i j) (evenStageZ2PComputed i j) := by
  unfold IntegerEncloses
  decide +kernel
theorem even_stage_z2p_sound : MatrixContains evenStageZ2PMatrix evenStageZ2PReal :=
  integer_matrix_enlargement _ _ _ even_stage_z2p_comparison
    (integer_matrix_mul_sound _ _ _ _ even_stage_z2_sound even_seed_p_sound)
