def evenStageZ2PIntegerMatrix (i j : Fin 31) : IntegerInterval :=
  ((evenStageZ2PData.getD i.val #[]).getD j.val ⟨0,0⟩)
def evenStageZ2PMatrix : Matrix (Fin 31) (Fin 31) Interval := integerMatrixInterval evenStageZ2PIntegerMatrix
def evenStageZ2PComputed : Matrix (Fin 31) (Fin 31) IntegerInterval := integerMatrixMul evenStageZ2IntegerMatrix evenSeedPIntegerMatrix
noncomputable def evenStageZ2PReal : Matrix (Fin 31) (Fin 31) ℝ := evenStageZ2Real*(Lemniscate.realFiniteStableProjection)
set_option maxRecDepth 100000 in
