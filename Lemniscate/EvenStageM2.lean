def evenStageM2IntegerMatrix (i j : Fin 31) : IntegerInterval :=
  ((evenStageM2Data.getD i.val #[]).getD j.val ⟨0,0⟩)
def evenStageM2Matrix : Matrix (Fin 31) (Fin 31) Interval := integerMatrixInterval evenStageM2IntegerMatrix
def evenStageM2Computed : Matrix (Fin 31) (Fin 31) IntegerInterval := integerMatrixMul evenStageQ2IntegerMatrix evenStageRIntegerMatrix
noncomputable def evenStageM2Real : Matrix (Fin 31) (Fin 31) ℝ := evenStageQ2Real*evenStageRReal
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem even_stage_m2_comparison : ∀ i j,
    IntegerEncloses (evenStageM2IntegerMatrix i j) (evenStageM2Computed i j) := by
  unfold IntegerEncloses
  decide +kernel
theorem even_stage_m2_sound : MatrixContains evenStageM2Matrix evenStageM2Real :=
  integer_matrix_enlargement _ _ _ even_stage_m2_comparison
    (integer_matrix_mul_sound _ _ _ _ even_stage_q2_sound even_stage_r_sound)
