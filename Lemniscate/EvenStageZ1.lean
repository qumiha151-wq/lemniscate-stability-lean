def evenStageZ1IntegerMatrix (i j : Fin 31) : IntegerInterval :=
  ((evenStageZ1Data.getD i.val #[]).getD j.val ⟨0,0⟩)
def evenStageZ1Matrix : Matrix (Fin 31) (Fin 31) Interval := integerMatrixInterval evenStageZ1IntegerMatrix
def evenStageZ1Computed : Matrix (Fin 31) (Fin 31) IntegerInterval := integerMatrixMul (integerMatrixTranspose evenSeedP0IntegerMatrix) evenStageH1IntegerMatrix
noncomputable def evenStageZ1Real : Matrix (Fin 31) (Fin 31) ℝ := ((Lemniscate.realFiniteAnchorProjection))ᵀ*evenStageH1Real
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem even_stage_z1_comparison : ∀ i j,
    IntegerEncloses (evenStageZ1IntegerMatrix i j) (evenStageZ1Computed i j) := by
  unfold IntegerEncloses
  decide +kernel
theorem even_stage_z1_sound : MatrixContains evenStageZ1Matrix evenStageZ1Real :=
  integer_matrix_enlargement _ _ _ even_stage_z1_comparison
    (integer_matrix_mul_sound _ _ _ _ (integer_matrix_transpose_sound _ _ even_seed_p0_sound) even_stage_h1_sound)
