def evenStageGram1IntegerMatrix (i j : Fin 31) : IntegerInterval :=
  ((evenStageGram1Data.getD i.val #[]).getD j.val ⟨0,0⟩)
def evenStageGram1Matrix : Matrix (Fin 31) (Fin 31) Interval := integerMatrixInterval evenStageGram1IntegerMatrix
def evenStageGram1Computed : Matrix (Fin 31) (Fin 31) IntegerInterval := integerMatrixMul (integerMatrixTranspose evenSeedPIntegerMatrix) evenSeedPIntegerMatrix
noncomputable def evenStageGram1Real : Matrix (Fin 31) (Fin 31) ℝ := ((Lemniscate.realFiniteStableProjection))ᵀ*(Lemniscate.realFiniteStableProjection)
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem even_stage_gram1_comparison : ∀ i j,
    IntegerEncloses (evenStageGram1IntegerMatrix i j) (evenStageGram1Computed i j) := by
  unfold IntegerEncloses
  decide +kernel
theorem even_stage_gram1_sound : MatrixContains evenStageGram1Matrix evenStageGram1Real :=
  integer_matrix_enlargement _ _ _ even_stage_gram1_comparison
    (integer_matrix_mul_sound _ _ _ _ (integer_matrix_transpose_sound _ _ even_seed_p_sound) even_seed_p_sound)
